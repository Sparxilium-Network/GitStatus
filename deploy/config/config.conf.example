# Format version of this file. setup.sh upgrades older files to the current version when a
# release adds or renames settings; do not change it by hand.
config.version=1

# System-level settings only. Repository / channel / event routing is managed in the
# admin TUI and stored in the database; do not configure it here.
# GitHub Apps are not configured here: setup.sh stores each App in secrets/github-apps/<App ID>/.
server.port=33444
database=/data/bot.db

# GitHub Enterprise Server: https://<host>/api/v3
github.apiUrl=https://api.github.com

discord.token=/run/secrets/discord-token

# How often the daemon checks for a new configuration revision
reload.intervalMs=5000
deliveryLog.retentionDays=30
